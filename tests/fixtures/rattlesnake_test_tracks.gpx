<!-- RED TRACK -->
<trk>
<name>Red Route - Summit Trail</name>
<desc>Primary summit trail to Rattlesnake Peak. Steep ascent through alpine meadows with spectacular views. 6.2 miles one-way, 3,200 feet elevation gain.</desc>
<extensions>
<onx:color>rgba(255,59,48,1)</onx:color>
<onx:style>solid</onx:style>
<onx:weight>4.0</onx:weight>
</extensions>
<trkseg>
<trkpt lat="47.020000" lon="-113.500000"><ele>1524</ele></trkpt>
<trkpt lat="47.025000" lon="-113.505000"><ele>1600</ele></trkpt>
<trkpt lat="47.030000" lon="-113.510000"><ele>1700</ele></trkpt>
<trkpt lat="47.035000" lon="-113.515000"><ele>1850</ele></trkpt>
