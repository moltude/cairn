<trkpt lat="47.055000" lon="-113.535000"><ele>2600</ele></trkpt>
</trkseg>
</trk>

<!-- BLUE TRACK -->
<trk>
<name>Blue Route - Lakeside Loop</name>
<desc>Scenic loop around Stuart Peak Lake. Gentle terrain, great for families. Wildflowers peak in July. 4.8 miles, 400 feet elevation gain.</desc>
