<?xml version="1.0" encoding="UTF-8"?>
<gpx xmlns:onx="https://wwww.onxmaps.com/" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd" version="1.1" creator="Cairn Color Test">
<metadata>
<name>OnX Waypoint Color Test</name>
<desc>Test file to discover OnX's actual waypoint color values. Import this, then manually change each waypoint to the specified color and export to verify.</desc>
</metadata>

<!-- TEST WAYPOINTS - One for each common color -->

<wpt lat="47.000000" lon="-113.500000">
<name>Test 01 - Red (CSS Standard)</name>
<desc>CSS Red: rgba(255,0,0,1) - Change to RED in OnX and export to verify</desc>
<extensions>
<onx:color>rgba(255,0,0,1)</onx:color>
<onx:icon>Location</onx:icon>
</extensions>
</wpt>

<wpt lat="47.005000" lon="-113.505000">
<name>Test 02 - Blue (CSS Standard)</name>
